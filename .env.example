# Copy to .env and fill in the real values. .env is never committed.
# Run with: node --env-file=.env dist/index.js

# Required. The RS485/TCP gateway's address on the local network.
METER_HOST=

# Optional. Modbus TCP well-known port.
METER_PORT=502

# Optional. RS485 instrument address, 1-247. EM111 default is 1.
METER_SLAVE_ID=1

# Optional. EM111 answers in ~40 ms typical, 500 ms max.
METER_RESPONSE_TIMEOUT_MS=500
